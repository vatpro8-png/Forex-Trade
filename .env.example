# SF CAPITAL FX Backend Configuration
# Development Environment
# Copy this to .env and fill in actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sfc_capital_fx
DB_USER=sfc_user
DB_PASSWORD=change_me_in_production

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8443
API_LOG_LEVEL=debug
ENVIRONMENT=development

# TradingView Webhook Configuration
TRADINGVIEW_WEBHOOK_SECRET=your_webhook_secret_here
TRADINGVIEW_WEBHOOK_PATH=/api/v1/webhooks/tradingview

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# JWT/Session Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
SESSION_TIMEOUT_MINUTES=60

# Payment Provider Configuration (when implemented)
PAYMENT_PROVIDER=stripe  # or similar
PAYMENT_API_KEY=pk_test_xxxxx
PAYMENT_API_SECRET=sk_test_xxxxx
PAYMENT_WEBHOOK_SECRET=whsec_xxxxx

# Redis Cache Configuration (for idempotency and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SSL/TLS Configuration
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@sfcapitalfx.com
SMTP_PASSWORD=app_password_here
SMTP_FROM=noreply@sfcapitalfx.com

# Admin Configuration
ADMIN_EMAIL=admin@sfcapitalfx.com
ADMIN_DEFAULT_PASSWORD=change_on_first_login

# Cloud/Deployment Configuration
CLOUD_PROVIDER=aws  # aws, gcp, azure
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
